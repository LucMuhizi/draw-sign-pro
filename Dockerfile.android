# Dockerfile for building Android APK
FROM ubuntu:22.04

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies (no apt JDK — we use Temurin tarball for reliability)
RUN apt-get update && apt-get install -y \
    wget \
    unzip \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Eclipse Temurin JDK 21 (required by Capacitor's jvmToolchain spec)
ENV JAVA_HOME=/opt/jdk-21
RUN mkdir -p $JAVA_HOME && \
    wget -q "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.5%2B11/OpenJDK21U-jdk_x64_linux_hotspot_21.0.5_11.tar.gz" -O /tmp/jdk21.tgz && \
    tar -xzf /tmp/jdk21.tgz -C $JAVA_HOME --strip-components=1 && \
    rm /tmp/jdk21.tgz && \
    $JAVA_HOME/bin/java -version

ENV PATH=$PATH:$JAVA_HOME/bin

# Install Android SDK
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools

RUN mkdir -p $ANDROID_HOME/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip && \
    unzip commandlinetools-linux-9477386_latest.zip -d $ANDROID_HOME/cmdline-tools && \
    mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest && \
    rm commandlinetools-linux-9477386_latest.zip

# Accept Android SDK licenses and install required packages
RUN yes | sdkmanager --licenses && \
    sdkmanager "platform-tools" "platforms;android-34" "build-tools;34.0.0" "cmdline-tools;latest"

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install npm dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the web app
RUN npm run build

# Copy Android project files
COPY android ./android
COPY capacitor.config.ts ./

# Sync Capacitor
RUN npx cap sync android

# Set working directory to android
WORKDIR /app/android

# Build the APK
RUN ./gradlew assembleDebug

# The APK will be at /app/android/app/build/outputs/apk/debug/app-debug.apk



